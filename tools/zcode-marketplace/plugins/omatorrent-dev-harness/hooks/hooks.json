{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PLUGIN_ROOT}/hooks/session_reminder.py\"",
            "timeoutMs": 10000,
            "statusMessage": "OmaTorrent dev harness reminder"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${ZCODE_PLUGIN_ROOT}/hooks/guard_destructive.py\"",
            "timeoutMs": 10000,
            "statusMessage": "OmaTorrent destructive-command guard"
          }
        ]
      }
    ]
  }
}
